  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::dialogController
  beginOnStart: 1
  swapScene: 0
  sceneName: 
  audioSource: {fileID: 972452263}
  sceneManagey: {fileID: 972452261}
  text:
  - 'After the baby showed who he really is, you were put into handcuffs. '
  - 'You were shown into a van with multiple convoy cars.  '
  - 'You were then shipped on a plane to the most secured prison on Earth, located
    on an island.  '
  - 'The prison is filled with the most notorious criminals in the world.  '
  - 'You are sent here to live the rest of your life.  '
  - 'But after some time you came to the realisation that this is not so bad. '
  - 'You get food, a roof over your head, activities to do, a free gym, and the people
    here are not so bad.  '
  - 'The best part of all is that you don''t have to worry about money anymore. '
  - 'You enjoy the rest of your life in paradise.  '
  - 'You enjoy the rest of your life in paradise.  '
  - '*Good End unlocked* '
